# 复制到项目根目录的 .env，再填写数据库口令和实际模型供应商的信息。
# 数据库与本机 HTTP 端口
# Generate each database password separately: python -c "import secrets; print(secrets.token_urlsafe(32))"
MYSQL_ROOT_PASSWORD=
AGENTOS_MIGRATION_PASSWORD=
AGENTOS_MYSQL_PASSWORD=
AGENTOS_API_PORT=8000

# 填供应商接受的模型或部署 ID、完整 HTTPS Chat Completions 地址及 Bearer 密钥。
AGENTOS_MODEL_NAME=gpt-6.1-sol
AGENTOS_MODEL_API_URL=https://llapi.org/v1/chat/completions
AGENTOS_MODEL_API_KEY=

# 模型窗口、最大输出和安全余量均以 Token 计。留空沿用发布配置。
# 例如窗口 8192、输出 512、安全余量 128。
AGENTOS_MODEL_WINDOW_TOKENS=
AGENTOS_MODEL_MAX_OUTPUT_TOKENS=
AGENTOS_MODEL_SAFETY_MARGIN_TOKENS=
# 每百万 Token 的人民币微元价格。每百万 Token 收费 2.50 元时填 2500000。
AGENTOS_MODEL_INPUT_MICROS_PER_MILLION=
AGENTOS_MODEL_OUTPUT_MICROS_PER_MILLION=

# 词法检索。Top-K 取 1～10，使用检索 Tool 时还受其 limit 限制。
# 最低分为非负数，仅采用匹配得分为正、且达到此阈值的证据。
AGENTOS_RAG_TOP_K=10
AGENTOS_RAG_MIN_SCORE=0
# 标题和正文匹配的权重均为非负有限数，至少一项大于零。
AGENTOS_RAG_TITLE_WEIGHT=2
AGENTOS_RAG_BODY_WEIGHT=1

# Native CLI paths. Compose supplies its own container paths.
# AGENTOS_RELEASE_FILE=local/release.json
# AGENTOS_CREDENTIALS_FILE=local/credentials.json

# Optional public HTTPS package index for image builds. Use a URL without credentials.
# AGENTOS_PYPI_INDEX_URL=https://pypi.org/simple
